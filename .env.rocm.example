# Experimental AMD ROCm/HIP local transcription.
# Validate your exact AMD GPU/runtime/CTranslate2 build before large batches.
# CTranslate2/faster-whisper still use device="cuda" for GPU execution on ROCm builds.
TRANSCRIPTION_BACKEND=faster-whisper

WHISPER_MODEL_NAME=large-v3
WHISPER_ACCELERATOR=rocm
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=float16
WHISPER_LANGUAGE=en
WHISPER_TASK=transcribe
WHISPER_BEAM_SIZE=5

# Start conservative. Increase only after a successful small-file smoke test.
WHISPER_BATCH_SIZE=4

WHISPER_VAD_FILTER=true
WHISPER_MIN_SILENCE_DURATION_MS=500
WHISPER_CONDITION_ON_PREVIOUS_TEXT=false
WHISPER_INITIAL_PROMPT=

# Optional Hugging Face token for model downloads.
HF_TOKEN=hf_your_token_here

# CPU fallback when ROCm initialization fails.
WHISPER_ALLOW_CPU_FALLBACK=true

INPUT_AUDIO_DIR=./data/audio_raw
TRANSCRIPTS_OUTPUT_DIR=./data/transcripts
SKIP_EXISTING=true
LOG_LEVEL=INFO
