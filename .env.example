## Template for local runtime configuration.
## Copy this to .env and keep real values out of Git.

# Backend selection.
TRANSCRIPTION_BACKEND=faster-whisper

# Local faster-whisper defaults.
WHISPER_MODEL_NAME=large-v3
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=float16
WHISPER_LANGUAGE=en
WHISPER_TASK=transcribe
WHISPER_BEAM_SIZE=5
WHISPER_BATCH_SIZE=8
WHISPER_VAD_FILTER=true
WHISPER_MIN_SILENCE_DURATION_MS=500
WHISPER_CONDITION_ON_PREVIOUS_TEXT=false
# Optional vocabulary/context prompt. Leave blank unless your audio has domain-specific terms.
WHISPER_INITIAL_PROMPT=

# Optional Hugging Face token for faster-whisper downloads.
# Create one at https://huggingface.co/settings/tokens and keep it only in .env.
HF_TOKEN=hf_your_token_here

# Optional local speaker diarization (install the `diarize` extra first).
DIARIZATION_MODEL=pyannote/speaker-diarization-3.1
DIARIZATION_DEVICE=cuda

# Required when TRANSCRIPTION_BACKEND is openai-whisper or openai-realtime-whisper.
OPENAI_API_KEY=sk_your_openai_api_key_here

# OpenAI cloud file transcription settings.
OPENAI_WHISPER_MODEL=whisper-1

# OpenAI realtime transcription settings.
OPENAI_REALTIME_MODEL=gpt-realtime-whisper
OPENAI_REALTIME_URL=wss://api.openai.com/v1/realtime?intent=transcription
OPENAI_REALTIME_AUDIO_RATE=24000
OPENAI_REALTIME_TURN_DETECTION=server_vad
OPENAI_REALTIME_NOISE_REDUCTION=near_field
OPENAI_REALTIME_TIMEOUT_SECONDS=120

# Local input and output paths.
INPUT_AUDIO_DIR=./data/audio_raw
TRANSCRIPTS_OUTPUT_DIR=./data/transcripts
SKIP_EXISTING=true
LOG_LEVEL=INFO
