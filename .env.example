WHISPER_MODEL_NAME=large-v3
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=float16
WHISPER_LANGUAGE=es
WHISPER_TASK=transcribe
WHISPER_BEAM_SIZE=5
WHISPER_BATCH_SIZE=8
WHISPER_VAD_FILTER=true
WHISPER_MIN_SILENCE_DURATION_MS=500
WHISPER_CONDITION_ON_PREVIOUS_TEXT=false
WHISPER_INITIAL_PROMPT=Transcripción literal de una entrevista en español de México sobre KADO, software para nutriólogos y nutricionistas. Vocabulario probable: consulta nutricional, expediente clínico, historia clínica, antropometría, composición corporal, IMC, índice cintura-cadera, peso, talla, grasa corporal, masa muscular, plan alimenticio, dieta, menú, equivalentes, pacientes, seguimiento, recordatorios, adherencia, WhatsApp, Excel, Google Sheets, agenda, receta, pagos, suscripción, plataforma, SaaS, flujo de trabajo.
# Optional Hugging Face token for higher download limits.
# Create one at https://huggingface.co/settings/tokens and keep .env private.
HF_TOKEN=hf_your_token_here

INPUT_AUDIO_DIR=./data/audio_raw
TRANSCRIPTS_OUTPUT_DIR=./data/transcripts
SKIP_EXISTING=true
LOG_LEVEL=INFO
